# Swell MCP Server Configuration
TRANSPORT_MODE=stdio
PORT=3000
DEBUG=false
NODE_ENV=development

# Swell API Configuration (REQUIRED)
SWELL_STORE_ID=your-store-id
SWELL_SECRET_KEY=your-secret-key

# Swell Environment (optional)
SWELL_ENVIRONMENT=production
# SWELL_ENVIRONMENT=sandbox

# Swell Client Configuration (optional)
SWELL_TIMEOUT=30000
SWELL_RETRIES=0
SWELL_MAX_SOCKETS=100
SWELL_KEEP_ALIVE_MS=1000
SWELL_RECYCLE_AFTER_REQUESTS=1000
SWELL_RECYCLE_AFTER_MS=15000